# ==========================================================
# UBSSUPER ECOSYSTEM – CENTRAL BACKEND CONFIGURATION
# ==========================================================

# Server
NODE_ENV=development
PORT=5000
API_VERSION=v1
API_BASE_URL=http://localhost:5000
ADMIN_PANEL_URL=http://localhost:3000
CUSTOMER_APP_SCHEME=ubssuper
PARTNER_APP_URL=http://localhost:8081
JWT_ACCESS_SECRET=ubssuper_access_token_super_secret_key_2026_jwt
JWT_REFRESH_SECRET=ubssuper_refresh_token_super_secret_key_2026_jwt
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
ENCRYPTION_KEY=ubs_super_partner_vault_master_key_2026_aes256gcm_secret
LOG_LEVEL=info
CORS_ORIGIN=*

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/ubssuper_ecosystem

# Razorpay Platform
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=rzp_test_placeholder_secret
RAZORPAY_WEBHOOK_SECRET=rzp_webhook_secret_placeholder
RAZORPAY_ENV=test

# Twilio SMS & OTP
TWILIO_ACCOUNT_SID=AC_twilio_test_account_sid
TWILIO_AUTH_TOKEN=twilio_test_auth_token
TWILIO_PHONE_NUMBER=+15005550006
OTP_EXPIRY_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5

# Cloudinary CDN
CLOUDINARY_CLOUD_NAME=dtubrloue
CLOUDINARY_API_KEY=463785848856518
CLOUDINARY_API_SECRET=placeholder_secret
CLOUDINARY_URL=cloudinary://463785848856518:placeholder_secret@dtubrloue

# Google Maps Platform
GOOGLE_MAPS_SERVER_API_KEY=placeholder_google_maps_server_api_key
GOOGLE_MAPS_COUNTRY_RESTRICTION=IN

# Firebase Cloud Messaging
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
